<dialog class="dialog" id="detail-dialog" aria-labelledby="dialog-heading"><div class="close-row"><button type="button" id="close-dialog" autofocus>閉じる ×</button></div><p class="eyebrow">遷移先の構成プレビュー</p><h2 id="dialog-heading"></h2><p id="dialog-intro"></p><ul id="dialog-list"></ul><p class="draft">下層ページは未実装です。現在のサービスや募集状況を示すものではありません。</p><button class="link" type="button" id="dialog-to-contact">お問い合わせの面へ →</button></dialog>
<script is:inline>
(()=>{
const stage=document.getElementById('stage');
const panels=Array.from(stage.querySelectorAll('.panel'));
const menu=document.querySelector('.mobile-menu');
const prefersReduced=()=>window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const behavior=()=>prefersReduced()?'auto':'smooth';
function moveTo(id,focus=true){
 const target=document.getElementById(id);if(!target)return;
 const panel=target.closest('.panel');if(!panel)return;
 menu.open=false;
 const point=target;
 const top=point.getBoundingClientRect().top-stage.getBoundingClientRect().top+stage.scrollTop;
 stage.scrollTo({top,behavior:behavior()});
 if(focus)target.focus({preventScroll:true});
}
document.querySelectorAll('a[href^="#"]').forEach(link=>link.addEventListener('click',event=>{const id=link.hash.slice(1);if(document.getElementById(id)){event.preventDefault();history.replaceState(null,'','#'+id);moveTo(id);}}));
function updatePanelNavigation(){
 const y=stage.scrollTop+stage.clientHeight*.4;
 let active=panels[0];for(const panel of panels){const top=panel.getBoundingClientRect().top-stage.getBoundingClientRect().top+stage.scrollTop;if(top<=y)active=panel;}
 document.querySelectorAll('.global-nav a,.panel-nav a').forEach(link=>{const target=document.getElementById(link.hash.slice(1));if(target===active)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');});
}
let frame=0;stage.addEventListener('scroll',()=>{if(frame)return;frame=requestAnimationFrame(()=>{updatePanelNavigation();frame=0;});},{passive:true});
const track=document.getElementById('practice-track');
const cards=Array.from(track.children);
const prev=document.getElementById('previous-card');const next=document.getElementById('next-card');
function cardStep(){return cards.length>1?cards[1].offsetLeft-cards[0].offsetLeft:track.clientWidth;}
function syncCarousel(){
 const max=Math.max(0,track.scrollWidth-track.clientWidth);prev.disabled=track.scrollLeft<=2;next.disabled=track.scrollLeft>=max-2;
 const box=track.getBoundingClientRect();const visible=cards.map((card,i)=>({i,b:card.getBoundingClientRect()})).filter(({b})=>Math.min(b.right,box.right)-Math.max(b.left,box.left)>b.width*.5);
 if(visible.length){const first=visible[0].i+1,last=visible[visible.length-1].i+1;document.getElementById('carousel-position').textContent=(first===last?String(first):first+'–'+last)+' / '+cards.length;}
}
function slide(direction){track.scrollBy({left:direction*cardStep(),behavior:behavior()});}
prev.addEventListener('click',()=>slide(-1));next.addEventListener('click',()=>slide(1));
track.addEventListener('keydown',event=>{if(event.target!==track)return;if(event.key==='ArrowRight'){event.preventDefault();slide(1);}if(event.key==='ArrowLeft'){event.preventDefault();slide(-1);}});
let cardFrame=0;track.addEventListener('scroll',()=>{if(cardFrame)return;cardFrame=requestAnimationFrame(()=>{syncCarousel();cardFrame=0;});},{passive:true});
new ResizeObserver(()=>{syncCarousel();updatePanelNavigation();}).observe(stage);
const details={about:['私たちについて','事務所の想いと、確認済みの弁護士情報を案内するページです。',['事務所の理念','弁護士の氏名・所属・経歴','事務所の紹介']],insurance:['保険代理店の皆さまへ','確認済みの案内内容を掲載する専用ページを想定しています。',['受け付ける相談内容','連絡方法・必要な情報']],recruit:['採用情報','募集の有無・要項・応募先は未確定です。',['弁護士・事務職の募集情報','応募方法・求人サイトへのリンク']],contact:['お問い合わせ','本番ではフォーム等の受付ページへ進む想定です。この試作では送信や個人情報の収集は行いません。',['相談方法・費用の案内','入力項目・個人情報の取扱い','送信結果の案内']],privacy:['プライバシーポリシー','実際の問い合わせ運用に合わせて作成します。',['利用目的・管理方法','保存期間・問い合わせ窓口']],sitemap:['サイトマップ','ページの構成案です。',['TOP','私たちについて','取扱業務','保険代理店の皆さまへ','採用情報','事務所案内','お問い合わせ']]};
const dialog=document.getElementById('detail-dialog');
document.querySelectorAll('[data-preview]').forEach(button=>button.addEventListener('click',()=>{const data=details[button.dataset.preview];document.getElementById('dialog-heading').textContent=data[0];document.getElementById('dialog-intro').textContent=data[1];const list=document.getElementById('dialog-list');list.replaceChildren();data[2].forEach(text=>{const li=document.createElement('li');li.textContent=text;list.append(li);});document.getElementById('dialog-to-contact').hidden=button.dataset.preview==='contact';dialog.showModal();}));
document.getElementById('close-dialog').addEventListener('click',()=>dialog.close());
document.getElementById('dialog-to-contact').addEventListener('click',()=>{dialog.close();moveTo('contact');});
window.addEventListener('hashchange',()=>moveTo(location.hash.slice(1),false));
window.addEventListener('load',()=>{if(location.hash)moveTo(location.hash.slice(1),false);syncCarousel();updatePanelNavigation();});
syncCarousel();updatePanelNavigation();
})();
</script>
</body>
</html>
